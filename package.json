{
	"name": "anki-card-manager",
	"version": "0.2.3",
	"description": "Render and manage obsidian-to-anki cards across an Obsidian vault.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --import tsx --test tests/*.test.ts",
		"test:browser": "node scripts/serve-editor-test.mjs"
	},
	"keywords": [
		"obsidian",
		"anki",
		"flashcards"
	],
	"author": "JaewonE",
	"homepage": "https://github.com/jaewonE/anki-card-manager",
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@codemirror/view-tiles": "npm:@codemirror/view@6.43.9",
		"@eslint/js": "^9.39.4",
		"@types/js-yaml": "^4.0.9",
		"@types/jsdom": "^30.0.0",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"js-yaml": "^4.3.2",
		"jsdom": "^29.1.1",
		"markdown-it": "^15.0.1",
		"obsidian": "latest",
		"tsx": "^4.20.6",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
